generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  teacher
  parent
}

enum PostCategory {
  LEARNING
  NUTRITION
  PARENTING
  HEALTH
}

model User {
  id            String      @id @default(uuid())
  name          String
  emailOrPhone  String      @unique
  passwordHash  String
  role          UserRole    @default(parent)
  
  // Optional: Teachers belong to a center
  ecdCenterId   String?
  ecdCenter     EcdCenter?  @relation(fields: [ecdCenterId], references: [id])
  
  // Parents have children
  children      Child[]     @relation("ParentToChild")
  
  likedPosts    PostLike[]
  savedPosts    PostSave[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model EcdCenter {
  id        String   @id @default(uuid())
  name      String
  location  String
  
  users     User[]
  children  Child[]
  nutrition NutritionRecord[]
  posts     Post[]
  adoptions PracticeAdoption[] @relation("AdoptingCenter")
}

model Child {
  id          String    @id @default(uuid())
  name        String
  age         Int
  
  parentId    String
  parent      User      @relation("ParentToChild", fields: [parentId], references: [id])
  
  centerId    String
  center      EcdCenter @relation(fields: [centerId], references: [id])
  
  attendance  AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  date      DateTime @db.Date
  status    String   // 'present' | 'absent'

  @@unique([childId, date]) // Ensures idempotency for sync
}

model NutritionRecord {
  id          String    @id @default(uuid())
  centerId    String
  center      EcdCenter @relation(fields: [centerId], references: [id])
  date        DateTime  @default(now()) @db.Date
  mealStatus  String    // e.g., 'Lunch'
  
  createdAt   DateTime  @default(now())
}

model Post {
  id           String             @id @default(uuid())
  title        String
  description  String
  category     PostCategory
  imageUrl     String?
  centerId     String
  center       EcdCenter          @relation(fields: [centerId], references: [id])
  
  likes        PostLike[]
  saves        PostSave[]
  adoptions    PracticeAdoption[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PostLike {
  id      String @id @default(uuid())
  postId  String
  post    Post   @relation(fields: [postId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model PostSave {
  id      String @id @default(uuid())
  postId  String
  post    Post   @relation(fields: [postId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model PracticeAdoption {
  id               String    @id @default(uuid())
  postId           String
  post             Post      @relation(fields: [postId], references: [id])
  adoptingCenterId String
  adoptingCenter   EcdCenter @relation("AdoptingCenter", fields: [adoptingCenterId], references: [id])
  
  createdAt        DateTime  @default(now())

  @@unique([postId, adoptingCenterId])
}

model Alert {
  id        String   @id @default(uuid())
  type      String   // e.g., 'MISSING_NUTRITION', 'HIGH_ABSENCE'
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}