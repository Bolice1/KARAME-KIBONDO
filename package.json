{
  "name": "karame-kibondo-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/db"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@karame/web",
    "dev:api": "npm run dev --workspace=@karame/api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build --workspace=@karame/web",
    "build:api": "npm run build --workspace=@karame/api",
    "db:generate": "prisma generate --schema=./infra/db/schema.prisma",
    "db:push": "prisma db push --schema=./infra/db/schema.prisma",
    "db:seed": "ts-node infra/db/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
